generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}
model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
model AppSettings {
  id            Int      @id @default(1)
  schoolName    String   @default("SMKS Nusantara Banyuwangi")
  appName       String   @default("NusaExam")
  description   String   @default("Sistem ujian sekolah")
  primaryColor  String   @default("#236b55")
  sidebarColor  String   @default("#17343a")
  updatedAt     DateTime @updatedAt
}

model AcademicYear {
  id        String       @id @default(cuid())
  label     String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  periods   ExamPeriod[]
  classrooms Classroom[]
  enrollments Enrollment[]
}

model ExamPeriod {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  name           String
  semester       Semester
  description    String       @default("")
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([academicYearId, semester, name])
  @@index([startDate, endDate])
  accounts ExamAccount[]
  executions TestExecution[]
}

enum Semester {
  GANJIL
  GENAP
}

model Department {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  archivedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  classrooms Classroom[]
}

model Classroom {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  name           String
  nameKey        String
  grade          Int
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@unique([academicYearId, nameKey])
  @@index([departmentId])
  enrollments Enrollment[]
}

model Student {
  id          String    @id @default(cuid())
  name        String
  nis         String?
  nisKey      String?   @unique
  nisn        String?   @unique
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  enrollments Enrollment[]
  examAccounts ExamAccount[]
  @@index([name])
  testAssignments TestAssignment[]
}
model ExamAccount {
  id                String     @id @default(cuid())
  examPeriodId      String
  examPeriod        ExamPeriod @relation(fields: [examPeriodId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  participantNumber String
  username          String
  usernameKey       String
  passwordHash      String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  @@unique([examPeriodId, participantNumber])
  @@unique([examPeriodId, usernameKey])
  @@unique([studentId, examPeriodId])
  @@index([examPeriodId])
}

model Enrollment {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@unique([studentId, classroomId])
  @@unique([studentId, academicYearId])
  @@index([classroomId])
}

enum ExecutionKind {
  REGULER
  SUSULAN
  REMIDI
}

model Test {
  id          String          @id @default(cuid())
  title       String          @unique
  description String?
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  banks       TestBank[]
  executions  TestExecution[]
}

model QuestionBank {
  id          String     @id @default(cuid())
  title       String    @unique
  subject     String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       TestItem[]
  tests       TestBank[]
}

model TestBank {
  id        String       @id @default(cuid())
  testId    String
  test      Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  bankId    String
  bank      QuestionBank @relation(fields: [bankId], references: [id], onDelete: Restrict)
  count     Int
  createdAt DateTime     @default(now())
  @@unique([testId, bankId])
}

model TestItem {
  id           String       @id @default(cuid())
  bankId       String
  bank         QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  order        Int
  question     String
  options      String[]
  correctIndex Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  @@unique([bankId, order])
}

model TestExecution {
  id              String           @id @default(cuid())
  testId          String
  test            Test             @relation(fields: [testId], references: [id], onDelete: Restrict)
  examPeriodId    String
  examPeriod      ExamPeriod       @relation(fields: [examPeriodId], references: [id], onDelete: Restrict)
  kind            ExecutionKind
  roomLabel       String           @default("Ruang 1")
  startAt         DateTime
  endAt           DateTime
  durationMinutes Int
  shuffleQuestions Boolean  @default(true)
  shuffleOptions   Boolean  @default(true)
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  assignments     TestAssignment[]
  @@index([examPeriodId])
}

model TestAssignment {
  id          String        @id @default(cuid())
  executionId String
  execution   TestExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  @@unique([executionId, studentId])
  @@index([studentId])
}
